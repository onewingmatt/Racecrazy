    public hitCheckpoint(id: number): boolean {
        if (this.state !== RaceState.RACING) return false;

        const now = performance.now();
        // Skip debounce check if this is the very first checkpoint hit (lastTriggerTime === 0)
        // because performance.now() might be very small in tests, triggering the debounce incorrectly.
        if (this.lastTriggerTime !== 0 && now - this.lastTriggerTime < this.TRIGGER_COOLDOWN_MS) {
            return false; // Debounced
        }

        // Must hit the *next* sequential checkpoint.
        // We do not allow skipping or going backwards.
        if (id === this.currentCheckpointId + 1 && id < this.maxCheckpoints) {
            this.currentCheckpointId = id;
            this.lastTriggerTime = now;
            return true;
        }

        return false;
    }